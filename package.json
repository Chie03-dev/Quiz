{
  "name": "quiz-instructor",
  "version": "0.2.8",
  "description": "LAN quiz instructor console - run quizzes from the phones in the room",
  "main": "./out/main/index.js",
  "author": "Quiz",
  "license": "MIT",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder --win portable nsis --publish never",
    "postinstall": "node scripts/ensure-native.cjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "fake-student": "tsx scripts/fake-student.ts",
    "check": "tsx scripts/check.ts && tsx scripts/import-check.ts",
    "ui-check": "tsx scripts/ui-check.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^12.11.1",
    "bonjour-service": "^1.3.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.2.1",
    "jszip": "^3.10.2",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.quiz.instructor",
    "productName": "Quiz Instructor",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map",
      "!**/{.editorconfig,.prettierrc,.eslintrc}",
      "!**/node_modules/*/{test,tests,__tests__,example,examples,doc,docs}/**/*",
      "!**/node_modules/*/*.{md,markdown,ts,map,flow}"
    ],
    "extraResources": [
      {
        "from": "resources/sample-meme.png",
        "to": "sample-meme.png"
      },
      {
        "from": "setup-firewall.bat",
        "to": "setup-firewall.bat"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "QuizInstructor-${version}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "QuizInstructor-${version}-setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
